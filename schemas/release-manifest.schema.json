{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evozeus.dev/schemas/factor-release-manifest.schema.json",
  "title": "EvoZeus Factor Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "git_tag",
    "source_review",
    "artifact",
    "checksum",
    "compatibility",
    "registry_publication_plan",
    "security_review",
    "review_state",
    "attestation",
    "sbom"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "git_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "source_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lab_path", "reviewer", "review_date"],
      "properties": {
        "lab_path": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "review_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["pack", "scanner-pack", "manifest-only"]
        }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "path"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256"]
        },
        "path": {
          "type": "string"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evozeus_protocol", "runtime"],
      "properties": {
        "evozeus_protocol": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      }
    },
    "registry_publication_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_repo", "pointer_path", "requires_pr"],
      "properties": {
        "target_repo": {
          "type": "string",
          "const": "MetaInFLow/EvoZeus"
        },
        "pointer_path": {
          "type": "string",
          "pattern": "^factors/registry/"
        },
        "requires_pr": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "review_state": {
      "type": "string",
      "enum": ["promoted", "deprecated", "yanked"]
    },
    "security_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "review_date"],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "review_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "attestation": {
      "type": "string"
    },
    "sbom": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
